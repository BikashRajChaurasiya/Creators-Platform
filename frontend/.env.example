# Frontend environment (build-time, must be NEXT_PUBLIC_* to reach the browser)
#
# In production this stays UNSET on purpose. The browser then calls /api/* on
# its own origin, and vercel.json rewrites those requests to the backend
# service, which removes CORS entirely and keeps the API hostname out of the
# bundle. Set it only when the API lives on a different origin, such as
# local development or a separately hosted API.

# Local development: `pnpm dev` runs the backend on :4000
NEXT_PUBLIC_API_URL=http://localhost:4000
