# ============================================================
# UGCNP - Vercel deployment environment
# The whole stack (Next.js frontend, NestJS API, FastAPI AI
# service) deploys from one Vercel project behind a single domain.
#
# Set these in the Vercel dashboard under Settings > Environment
# Variables. `AI_SERVICE_URL` is NOT set by hand: it is injected
# at runtime by the `ai` service binding declared in vercel.json.
# ============================================================

# --- Database (Neon, recommended) ---
# Use the POOLED connection string for the running application. Run
# `prisma migrate deploy` with the same URL but WITHOUT `pgbouncer=true`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true&connection_limit=1

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=2592000
EMAIL_OTP_EXPIRES=300

# --- Object storage (Cloudflare R2, recommended) ---
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=ugcnp-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_USE_SSL=true
STORAGE_FORCE_PATH_STYLE=false
STORAGE_AUTO_CREATE=false
# Public URL of the bucket, e.g. https://media.example.com
STORAGE_PUBLIC_BASE=

# --- Frontend ---
# Leave unset in production. The frontend calls /api/* on its own origin,
# which vercel.json rewrites to the backend service, so no CORS and no
# hardcoded hostname in the bundle.
#
# For local development, set it in frontend/.env.local (not here, so the
# production bundle never picks it up):
#   NEXT_PUBLIC_API_URL=http://localhost:4000
# `pnpm dev` serves the frontend on :3000 and the backend on :4000.
NEXT_PUBLIC_API_URL=

# --- CORS ---
# Comma separated list of allowed origins. The deployment's own
# Vercel hostnames are always trusted, so this only needs extra
# origins such as a custom domain. Use `*` to allow any origin.
APP_URL=http://localhost:3000

# --- Email ---
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="UGCNP <no-reply@ugcnp.com>"

# --- Optional ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMS_PROVIDER=console

# --- Platform ---
PLATFORM_COMMISSION_PERCENT=15
PLATFORM_VAT_PERCENT=13
PLATFORM_TDS_PERCENT=15
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- Realtime ---
# Serverless runtimes cannot hold an upgraded socket open, so this
# stays false in production and messaging uses REST polling.
WEBSOCKETS_ENABLED=false
