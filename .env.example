# ============================================================
# UGCNP — Root environment template
# Copy to the appropriate locations: backend/.env, frontend/.env.local
# ============================================================

# --- Shared ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Backend (backend/.env) ---
DATABASE_URL=postgresql://ugcnp:ugcnp@localhost:5432/ugcnp?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=2592000
EMAIL_OTP_EXPIRES=300
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=change-me
EMAIL_FROM="UGCNP <no-reply@ugcnp.com>"

# S3-compatible storage (MinIO for dev)
STORAGE_ENDPOINT=localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=ugcnp-media
STORAGE_ACCESS_KEY=ugcnp-minio
STORAGE_SECRET_KEY=uygcnp-minio-secret
STORAGE_USE_SSL=false
STORAGE_PUBLIC_BASE=http://localhost:9000/ugcnp-media

# Optional OAuth / SMS (stubbed behind providers, activate with real creds)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMS_PROVIDER=console

# Platform
PLATFORM_COMMISSION_PERCENT=15