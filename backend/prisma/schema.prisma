// ============================================================
// UGCNP — Prisma schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------ enums
enum Role {
  CREATOR
  BRAND
  ADMIN
  MANAGER
  QA
  FINANCE
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  RECRUITING
  SHORTLISTING
  PRODUCTION
  REVIEW
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum CampaignObjective {
  BRAND_AWARENESS
  PRODUCT_LAUNCH
  SALES_CONVERSION
  ENGAGEMENT
  USER_GENERATED_CONTENT
  TRAFFIC
}

enum PlatformType {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  X
  LINKEDIN
}

enum DeliverableType {
  REEL
  SHORT
  PHOTO_CAROUSEL
  SINGLE_PHOTO
  STORY
  YOUTUBE_VIDEO
  TIKTOK
  FACEBOOK_POST
}

enum UsageRights {
  EXCLUSIVE_FOREVER
  NON_EXCLUSIVE
  TIMED_LICENSE
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  IN_REVISION
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  APPROVED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentType {
  CAMPAIGN_PAYOUT
  COMMISSION
  ADJUSTMENT
  REFUND
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum NotificationType {
  EMAIL
  PUSH
  IN_APP
}

enum NotificationEvent {
  CAMPAIGN_INVITE
  APPLICATION_RECEIVED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  REVISION_REQUEST
  SUBMISSION_APPROVED
  PAYMENT_COMPLETED
  NEW_MESSAGE
  CAMPAIGN_STATUS_CHANGE
  SYSTEM
}

enum FileKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

// ------------------------------------------------------------ core
model User {
  id                  String             @id @default(uuid())
  name                String
  email               String             @unique
  phone               String?
  passwordHash        String?
  role                Role               @default(CREATOR)
  status              UserStatus         @default(PENDING)
  emailVerified       Boolean            @default(false)
  avatarUrl           String?
  refreshTokenVersion Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  creatorProfile      CreatorProfile?
  brand               Brand?

  refreshTokens       RefreshToken[]
  verificationCodes   VerificationCode[]
  conversations       ConversationParticipant[]
  sentMessages        Message[]          @relation("MessageSender")
  notifications       Notification[]
  creatorSubmissions  Submission[]       @relation("SubmissionCreator")
  paymentsReceived    Payment[]          @relation("PaymentCreator")
  auditLogs           AuditLog[]         @relation("AuditActor")
  createdCampaigns    Campaign[]         @relation("CampaignCreator")

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationCode {
  id         String      @id @default(uuid())
  userId     String?
  email      String
  codeHash   String
  purpose    String // LOGIN | REGISTER | PASSWORD_RESET
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int         @default(0)
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
}

// ------------------------------------------------------------ creator
model CreatorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  bio                String?
  city               String?
  district           String?
  language           String[]           @default([])
  category           String?
  instagram          String?
  tiktok             String?
  youtube            String?
  facebook           String?
  skills             String[]           @default([])
  rateMin            Int?
  rateMax            Int?
  availableForWork   Boolean            @default(true)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  followersEstimate  Int?
  engagementRate     Float?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio          PortfolioItem[]

  platforms          PlatformLink[]
  verifications      CreatorVerification[]
  applications       Application[]       @relation("ProfileApplications")
  invites            CampaignInvite[]

  @@index([category])
  @@index([city])
  @@index([verificationStatus])
}

model PlatformLink {
  id         String   @id @default(uuid())
  profileId  String
  platform   String
  handle     String?
  url        String
  followers  Int?
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  profile    CreatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, platform])
}

model PortfolioItem {
  id         String         @id @default(uuid())
  profileId  String
  title      String
  url        String
  kind       FileKind
  thumbnail  String?
  caption    String?
  createdAt  DateTime       @default(now())
  profile    CreatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model CreatorVerification {
  id          String             @id @default(uuid())
  profileId   String
  documentUrl String?
  notes       String?
  status      VerificationStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime           @default(now())
  profile     CreatorProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------ brand
model Brand {
  id                 String             @id @default(uuid())
  userId             String             @unique
  companyName        String
  industry           String?
  website            String?
  contactPerson      String?
  description        String?
  address            String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns          Campaign[]
  verifications      BrandVerification[]
  invoices           Invoice[]

  @@index([verificationStatus])
}

model BrandVerification {
  id         String             @id @default(uuid())
  brandId    String
  documentUrl String?
  notes      String?
  status     VerificationStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime           @default(now())
  brand      Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------ campaign
model Campaign {
  id                 String             @id @default(uuid())
  brandId            String
  title              String
  description        String
  objective          CampaignObjective
  product            String
  targetAudience     Json?
  targetLocations    String[]           @default([])
  platforms          PlatformType[]
  creatorRequirements Json?
  deliverables       Json
  deadline           DateTime
  budgetMin          Int
  budgetMax          Int
  currency           String             @default("NPR")
  perCreator         Boolean            @default(true)
  usageRights        UsageRights
  status             CampaignStatus     @default(DRAFT)
  slug               String             @unique
  createdById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  publishedAt        DateTime?
  completedAt        DateTime?

  brand              Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy          User               @relation("CampaignCreator", fields: [createdById], references: [id])
  applications       Application[]
  submissions        Submission[]
  payments           Payment[]
  invoices           Invoice[]
  invites            CampaignInvite[]
  conversations      Conversation[]

  @@index([brandId])
  @@index([status])
  @@index([objective])
}

model CampaignInvite {
  id         String   @id @default(uuid())
  campaignId String
  creatorId  String   // creator profile id
  message    String?
  status     String   @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorId])
}

// ------------------------------------------------------------ applications & submissions
model Application {
  id            String            @id @default(uuid())
  campaignId    String
  creatorId     String
  pitch         String
  proposedRate  Int?
  status        ApplicationStatus @default(PENDING)
  brandNote     String?
  reviewedAt    DateTime?
  reviewedById  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  campaign      Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator       CreatorProfile    @relation("ProfileApplications", fields: [creatorId], references: [id], onDelete: Cascade)
  submissions   Submission[]
  payment       Payment?

  @@unique([campaignId, creatorId])
  @@index([status])
  @@index([campaignId, status])
}

model Submission {
  id            String           @id @default(uuid())
  applicationId String
  creatorId     String
  campaignId    String
  version       Int              @default(1)
  fileUrl       String
  caption       String?
  notes         String?
  status        SubmissionStatus @default(SUBMITTED)
  aiAnalysis    Json?
  feedback      String?
  feedbackAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  creator       User             @relation("SubmissionCreator", fields: [creatorId], references: [id])
  campaign      Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version])
  @@index([creatorId])
}

// ------------------------------------------------------------ payments
model Payment {
  id          String        @id @default(uuid())
  campaignId  String
  applicationId String      @unique
  creatorId   String
  amount      Int           // in minor units? store NPR paisas? Keep integers as amounts (NPR)
  commissionPercent Float   @default(15)
  commissionAmount Int
  payoutAmount Int
  type        PaymentType   @default(CAMPAIGN_PAYOUT)
  status      PaymentStatus @default(PENDING)
  transactionId String?
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  paidAt      DateTime?

  campaign    Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  application Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  creator     User          @relation("PaymentCreator", fields: [creatorId], references: [id])

  @@index([creatorId])
  @@index([status])
}

model Invoice {
  id         String        @id @default(uuid())
  brandId    String
  campaignId String
  amount     Int
  commissionPercent Float  @default(15)
  commissionAmount Int
  status     InvoiceStatus @default(DRAFT)
  dueDate    DateTime?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  brand      Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@index([brandId])
}

// ------------------------------------------------------------ messaging
model Conversation {
  id           String                     @id @default(uuid())
  campaignId   String?
  campaign     Campaign?                  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  participants ConversationParticipant[]
  messages     Message[]

  @@index([campaignId])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  unreadCount    Int          @default(0)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType   @default(TEXT)
  content        String
  fileUrl        String?
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

// ------------------------------------------------------------ notifications
model Notification {
  id         String             @id @default(uuid())
  userId     String
  type       NotificationType   @default(IN_APP)
  event      NotificationEvent  @default(SYSTEM)
  title      String
  body       String
  link       String?
  readAt     DateTime?
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ------------------------------------------------------------ admin
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  ip         String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  assigneeId  String?
  campaignId  String?
  status      String       @default("TODO") // TODO | IN_PROGRESS | BLOCKED | DONE
  priority    String       @default("MEDIUM")
  dueDate     DateTime?
  createdById String
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([assigneeId])
}

model Dispute {
  id         String        @id @default(uuid())
  campaignId String?
  applicationId String?
  raisedById String
  subject    String
  description String
  status     DisputeStatus @default(OPEN)
  resolution String?
  resolvedById String?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
}

// ------------------------------------------------------------ media
model Upload {
  id          String   @id @default(uuid())
  userId      String
  kind        FileKind
  bucket      String
  key         String
  url         String
  fileName    String
  mimeType    String
  size        Int
  etag        String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([key])
}