NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000

# Local Postgres. In production this is a Neon pooled connection string:
#   postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true&connection_limit=1
# Use the SAME database without `pgbouncer=true` when running `prisma:migrate:deploy`.
DATABASE_URL=postgresql://ugcnp:ugcnp@localhost:5432/ugcnp?schema=public

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=2592000
EMAIL_OTP_EXPIRES=300

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@ugcnp.com
SMTP_PASS=change-me
EMAIL_FROM="UGCNP <no-reply@ugcnp.com>"
EMAIL_MODE=console

# S3-compatible object storage (Cloudflare R2 in production).
# R2: STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, REGION=auto
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=ugcnp-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_USE_SSL=true
STORAGE_FORCE_PATH_STYLE=false
STORAGE_AUTO_CREATE=false
# Public base URL of the bucket, used to build asset links.
STORAGE_PUBLIC_BASE=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMS_PROVIDER=console

# On Vercel this is injected automatically by the `ai` service binding.
AI_SERVICE_URL=http://localhost:5001

# WebSockets need a long-lived connection, which serverless runtimes cannot
# provide. Leave false on Vercel; messaging uses the REST endpoints instead.
WEBSOCKETS_ENABLED=false

PLATFORM_COMMISSION_PERCENT=15
# Tax placeholders - verify before launch (blueprint section 12)
PLATFORM_VAT_PERCENT=13
PLATFORM_TDS_PERCENT=15

THROTTLE_TTL=60
THROTTLE_LIMIT=120
