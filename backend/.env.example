NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000

# Docker infra on host ports (see docker/.env)
DATABASE_URL=postgresql://ugcnp:ugcnp@localhost:5444/ugcnp?schema=public
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=2592000
EMAIL_OTP_EXPIRES=300

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@ugcnp.com
SMTP_PASS=change-me
EMAIL_FROM=UGCNP <no-reply@ugcnp.com>
EMAIL_MODE=console

STORAGE_ENDPOINT=localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=ugcnp-media
STORAGE_ACCESS_KEY=ugcnp-minio
STORAGE_SECRET_KEY=ugcnp-minio-secret
STORAGE_USE_SSL=false
STORAGE_PUBLIC_BASE=http://localhost:9000/ugcnp-media

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMS_PROVIDER=console

AI_SERVICE_URL=http://localhost:5001
PLATFORM_COMMISSION_PERCENT=15

THROTTLE_TTL=60
THROTTLE_LIMIT=120