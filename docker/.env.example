# Docker compose overrides for local dev.
# Ports chosen to avoid collisions with other local services.
# Copy to docker/.env to use; compose also works with defaults.

POSTGRES_PORT=5444
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=4000
AI_PORT=5001
FRONTEND_PORT=3000
PGADMIN_PORT=5050

POSTGRES_USER=ugcnp
POSTGRES_PASSWORD=ugcnp
POSTGRES_DB=ugcnp

MINIO_ROOT_USER=ugcnp-minio
MINIO_ROOT_PASSWORD=ugcnp-minio-secret

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Baked into the frontend image at build time
API_URL=http://localhost:4000
AI_URL=http://localhost:5001
WS_URL=http://localhost:4000